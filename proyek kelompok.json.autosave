GameOverText",""]},{"type":{"value":"ActivateBehavior"},"parameters":["MC","PlatformerObject","no"]},{"type":{"await":true,"value":"Wait"},"parameters":["1.5"]},{"type":{"value":"Scene"},"parameters":["","\"Tempat kejadian tanpa judul\"","no"]}]},{"aiGeneratedEventId":"01M5YE4KWZ1Y2N1JADP1C4G2X7","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyFromTextJustPressed"},"parameters":["","\"e\""]},{"type":{"value":"NumberVariable"},"parameters":["Keys",">","0"]},{"type":{"inverted":true,"value":"BooleanVariable"},"parameters":["GameOver","True",""]}],"actions":[{"type":{"value":"PickNearest"},"parameters":["Penjara","MC.X()","MC.Y()"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Distance"},"parameters":["MC","Penjara","260",""]},{"type":{"value":"StringObjectVariable"},"parameters":["Penjara","State","=","\"closed\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Penjara","State","=","\"open\""]},{"type":{"value":"SetNumberVariable"},"parameters":["Keys","-","1"]},{"type":{"value":"SetNumberVariable"},"parameters":["OpeningCell","=","Penjara.CellId"]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Penjara","Animation","=","\"Open\""]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["NPC","CellId","=","OpeningCell"]},{"type":{"inverted":true,"value":"BooleanObjectVariable"},"parameters":["NPC","Following","True",""]}],"actions":[{"type":{"value":"SetBooleanObjectVariable"},"parameters":["NPC","Following","True",""]},{"type":{"value":"SetNumberVariable"},"parameters":["FollowCount","+","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["NPC","Index","=","FollowCount"]}]}]}]},{"aiGeneratedEventId":"01M5YE4KWZ1Y2N1JADP1C4G2X7","type":"BuiltinCommonInstructions::ForEach","object":"NPC","conditions":[],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanObjectVariable"},"parameters":["NPC","Following","True",""]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["TargetX","=","MC.X() - 120 * NPC.Index"]},{"type":{"value":"SetX"},"parameters":["NPC","=","NPC.X() + (TargetX - NPC.X()) * min(1, 8 * TimeDelta())"]},{"type":{"value":"SetY"},"parameters":["NPC","=","MC.Y() + MC.Height() - NPC.Height()"]}],"variables":[{"name":"TargetX","type":"number","value":0.0}]}]},{"aiGeneratedEventId":"01M5YE4KWZ1Y2N1JADP1C4G2X7","type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["KeysText","Text","=","\"Kunci: \" + ToString(Keys) + \"/3\""]}]},{"aiGeneratedEventId":"01M5YE4KWZ1Y2N1JADP1C4G2X7","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"inverted":true,"value":"BooleanVariable"},"parameters":["GameOver","True",""]},{"type":{"value":"NumberVariable"},"parameters":["Keys",">","0"]}],"actions":[{"type":{"value":"PickNearest"},"parameters":["Penjara","MC.X()","MC.Y()"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"Distance"},"parameters":["MC","Penjara","260",""]},{"type":{"value":"StringObjectVariable"},"parameters":["Penjara","State","=","\"closed\""]}],"actions":[{"type":{"value":"Show"},"parameters":["HintText",""]}]},{"type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"Hide"},"parameters":["HintText"]}]}]},{"aiGeneratedEventId":"01M5YE4KWZ1Y2N1JADP1C4G2X7","type":"BuiltinCommonInstructions::Else","conditions":[],"actions":[{"type":{"value":"Hide"},"parameters":["HintText"]}]},{"aiGeneratedEventId":"01M5YE4KWZ1Y2N1JADP1C4G2X7","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["FollowCount",">=","3"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MissionText","Text","=","\"Semua NPC sudah dibebaskan! Tinggal menuju area finish.\""]}]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"UI","renderingType":"","visibility":true,"cameras":[],"effects":[]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"FireBullet","type":"FireBullet::FireBullet"},{"name":"Flash","type":"Flash::Flash"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Health","type":"Health::Health"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"TileMap","type":"TileMap::TileMapBehavior"}]}],"externalEvents":[],"tests":[{"description":"Memastikan balok Tiles_And_Props tidak bergerak dan karakter tidak menembusnya.","lastRunAt":1793095429821.0,"lastRunDurationMs":907.0,"lastRunFramesExecuted":179,"lastRunStatus":"passed","name":"Balok solid dan karakter berjalan di atasnya","type":"gameplay","source":["await harness.goToScene('Tempat kejadian tanpa judul');","await harness.stepFrames(5);","const blocksBefore = harness.getObjects('Tiles_And_Props').map(o => ({ id: o.id, x: o.x, y: o.y, w: o.width, h: o.height }));","harness.assert(blocksBefore.length >= 10, 'Ada ' + blocksBefore.length + ' balok di scene');","","// Biarkan semua karakter jatuh dan menetap.","await harness.stepUntilObjectIsStable('Swykhe', { tolerance: 1, stableFrames: 30, maxFrames: 300 });","const blocksAfter = harness.getObjects('Tiles_And_Props').map(o => ({ id: o.id, x: o.x, y: o.y }));","let moved = 0;","for (const b of blocksBefore) {","  const a = blocksAfter.find(o => o.id === b.id);","  if (!a || Math.abs(a.x - b.x) > 1 || Math.abs(a.y - b.y) > 1) moved++;","}","harness.assert(moved === 0, 'Semua balok tetap di posisi semula (yang bergerak: ' + moved + ')');","","const sw = harness.getObjects('Swykhe')[0];","harness.assert(!!sw.behaviors.PlatformerObject.state.IsOnFloor, 'Swykhe menginjak balok (IsOnFloor), y=' + sw.y + ' floor=' + JSON.stringify(sw.behaviors.PlatformerObject.state));","","// Berjalan ke kanan di atas balok.","const startX = sw.x, startY = sw.y;","harness.setKeyPressed('Right', true);","const walked = await harness.stepUntil(() => harness.getObjects('Swykhe')[0].x > startX + 120, { maxFrames: 240 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(20);","const sw2 = harness.getObjects('Swykhe')[0];","harness.assert(walked, 'Swykhe berjalan ke kanan dari ' + startX + ' ke ' + sw2.x);","harness.assert(Math.abs(sw2.y - startY) < 40, 'Swykhe tidak jatuh menembus balok saat berjalan (y ' + startY + ' -> ' + sw2.y + ')');","harness.assert(!!sw2.behaviors.PlatformerObject.state.IsOnFloor, 'Swykhe masih menginjak balok setelah berjalan');","","// Lompat.","harness.setKeyPressed('Space', true);","await harness.stepFrames(6);","harness.setKeyPressed('Space', false);","const jumped = await harness.stepUntil(() => harness.getObjects('Swykhe')[0].y < sw2.y - 30, { maxFrames: 60 });","harness.assert(jumped, 'Swykhe bisa melompat');","await harness.stepUntilObjectIsStable('Swykhe', { tolerance: 1, stableFrames: 30, maxFrames: 240 });","const sw3 = harness.getObjects('Swykhe')[0];","harness.assert(!!sw3.behaviors.PlatformerObject.state.IsOnFloor, 'Swykhe mendarat kembali di atas balok, y=' + sw3.y);","await harness.takeScreenshot('setelah berjalan dan melompat');"]},{"description":"Uji alur misi: patroli musuh, tembak, ambil kunci, buka kurungan, NPC mengikuti, game over.","lastRunAt":1793096764706.0,"lastRunDurationMs":2313.0,"lastRunFramesExecuted":651,"lastRunStatus":"passed","name":"Alur misi MC selamatkan NPC","type":"gameplay","source":["await harness.goToScene('Tempat kejadian tanpa judul');","await harness.stepFrames(30);","const sc = (n) => (harness.getSceneVariable(n) || {}).value;","harness.assert(sc('GameOver') !== true, 'MC belum tertangkap di awal');","const before = harness.getObjects('Enemy').map(e => ({ id: e.id, x: e.x }));","await harness.stepFrames(90);","const after = harness.getObjects('Enemy').map(e => ({ id: e.id, x: e.x }));","let patrolled = 0;","for (const b of before) { const a = after.find(o => o.id === b.id); if (a && Math.abs(a.x - b.x) > 5) patrolled++; }","harness.assert(patrolled >= 3, 'ketiga musuh bergerak patroli (' + patrolled + ')');","for (let i = 0; i < 4; i++) {","  harness.setKeyPressed('j', true);","  await harness.stepFrames(2);","  harness.setKeyPressed('j', false);","  await harness.stepFrames(12);","}","const alive = harness.getObjects('Enemy').length;","harness.assert(alive === 2, 'satu musuh mati setelah ditembak, sisa ' + alive);","harness.assert(harness.getObjects('Key').length === 1, 'kunci muncul di tempat musuh mati');","await harness.takeScreenshot('setelah musuh pertama mati');","harness.setKeyPressed('Right', true);","const gotKey = await harness.stepUntil(() => (harness.getSceneVariable('Keys') || {}).value >= 1, { maxFrames: 600 });","harness.setKeyPressed('Right', false);","harness.assert(gotKey, 'MC mengambil kunci, Keys=' + sc('Keys'));","await harness.stepFrames(10);","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","await harness.stepFrames(10);","const cells = harness.getObjects('Penjara').map(p => ({ id: p.id, state: (harness.getObjectVariable(p.id, 'State') || {}).value }));","harness.assert(cells.some(c => c.state === 'open'), 'satu kurungan terbuka: ' + JSON.stringify(cells));","harness.assert(sc('Keys') === 0, 'kunci terpakai, Keys=' + sc('Keys'));","const swykhe = harness.getObjects('Swykhe')[0];","harness.assert(!!(harness.getObjectVariable(swykhe.id, 'Following') || {}).value, 'Swykhe mulai mengikuti MC');","const swBefore = harness.getObjects('Swykhe')[0].x;","harness.setKeyPressed('Right', true);","await harness.stepFrames(90);","harness.setKeyPressed('Right', false);","await harness.stepFrames(40);","const swAfter = harness.getObjects('Swykhe')[0];","const mcNow = harness.getObjects('MC')[0];","harness.assert(swAfter.x > swBefore + 20, 'Swykhe mengikuti MC (' + Math.round(swBefore) + ' -> ' + Math.round(swAfter.x) + ')');","harness.assert(Math.abs(swAfter.x - mcNow.x) < 500, 'Swykhe tetap dekat MC');","await harness.takeScreenshot('NPC mengikuti MC');","await harness.goToScene('Tempat kejadian tanpa judul');","await harness.stepFrames(20);","harness.setKeyPressed('Right', true);","const died = await harness.stepUntil(() => (harness.getSceneVariable('GameOver') || {}).value === true, { maxFrames: 900 });","harness.setKeyPressed('Right', false);","harness.assert(died, 'MC tertangkap saat menyentuh musuh (game over)');","await harness.takeScreenshot('game over');"]}],"eventsFunctionsExtensions":[{"author":"@4ian","category":"Game mechanic","dimension":"2D/3D","extensionNamespace":"","fullName":"Fire bullets","gdevelopVersion":">=5.5.222","helpPath":"/extensions/fire-bullet/details","iconUrl":"data:image/svg+xml;base64,","name":"FireBullet","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/bullet.svg","shortDescription":"Fire bullets with ammo count, reload timer, and overheat management.","version":"0.11.0","description":["This extension allows objects to fire bullets. To use it, add the behavior to the object that will shoot, then use the provided action to launch another object as the bullet.","","The properties of the behavior can be used to customize:","- Cooldown between shots","- Firing multiple bullets at a time ([open the project online](https://editor.gdevelop.io/?project=example://fire-bullet))","- Ammo management","- Overheat","","The speed can be specified when using the actions to fire the bullets.","The bullets are automatically given a permanent force to make them move in the 2D plane (no need to use a linear movement or move them with another behavior).","","It can be used for:","- Twin-stick shooters ([open the project online](https://editor.gdevelop.io/?project=example://conviction-of-gun-dude-desktop))","- Shoot'em up ([open the project online](https://editor.gdevelop.io/?project=example://space-shooter))","","A simple example shows how to make firing patterns ([open the project online](https://editor.gdevelop.io/?project=example://firing-patterns))."],"origin":{"identifier":"FireBullet","name":"gdevelop-extension-store"},"tags":["fire","bullet","spawn","firerate","reload","weapon","ranged","ammo","overheat"],"authorIds":["wWP8BSlAW0UP4NeaHa2LcmmDzmH2","xpwUwByyImTDcHEqDUqfyg0oRBt1","2OwwM8ToR9dx9RJ2sAKTcrLmCB92","gqDaZjCfevOOxBYkK6zlhtZnXCg1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Define helper classes JavaScript code.","fullName":"Define helper classes","functionType":"Action","name":"DefineHelperClasses","private":true,"sentence":"Define helper classes JavaScript code","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["//@ts-ignore","if (gdjs.__fireBulletExtension) {","    //@ts-ignore","    return;","}","","/**"," * It can be built the follow:"," * "," * `objectDefaultRotation.setFromAxisAngle(new THREE.Vector3(1, 0, 0), Math.PI/2);`"," * "," * `objectDefaultRotation.multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0, 0, 1), -Math.PI/2));`"," * "," */","const objectDefaultRotation = new THREE.Quaternion(0.5, 0.5, -0.5, 0.5);","","/**"," * @param {gdjs.RuntimeObject3D} object"," */","function rotateObjectToFaceSameWayAsCamera(object) {","    const layer = object.getInstanceContainer().getLayer(object.getLayer());","    const threeCamera = layer.getRenderer().getThreeCamera();","    const threeObject = object.get3DRendererObject();","","    threeObject.rotation.copy(threeCamera.rotation);","    threeObject.rotation.z = -threeObject.rotation.z;","    threeObject.rotation.x = -threeObject.rotation.x;","    threeObject.quaternion.multiply(objectDefaultRotation);","","    const {x, y, z } = threeObject.rotation;","    object.setAngle(gdjs.toDegrees(z));","    object.setRotationY(gdjs.toDegrees(y));","    object.setRotationX(gdjs.toDegrees(x));","}","","//@ts-ignore","gdjs.__fireBulletExtension = {","    rotateObjectToFaceSameWayAsCamera","};",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"parameters":[],"objectGroups":[]},{"fullName":"Rotate the same way as camera","functionType":"Action","name":"RotateObjectToFaceSameWayAsCamera","private":true,"sentence":"Rotate _PARAM1_ to look the same way as the camera","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const object = objects[0];","","const { rotateObjectToFaceSameWayAsCamera } = gdjs.__fireBulletExtension;","","rotateObjectToFaceSameWayAsCamera(object);"],"parameterObjects":"Object","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Object","name":"Object","type":"objectList"},{"description":"3D capability","name":"Object3D","supplementaryInformation":"Scene3D::Base3DBehavior","type":"behavior"}],"objectGroups":[]}],"eventsFunctionsFolderStructure":{"folderName":"__ROOT","children":[{"functionName":"DefineHelperClasses"},{"functionName":"RotateObjectToFaceSameWayAsCamera"}]},"eventsBasedBehaviors":[{"description":"Fire bullets with built-in cooldown, ammo, reloading, and overheating. Once added to your object that must shoot, use the behavior actions to fire another object as a bullet. These actions check all constraints internally (can be called without conditions, they will only fire when ready) and will make the bullet move (using a permanent force).","fullName":"Fire bullets","helpPath":"","iconUrl":"","name":"FireBullet","objectType":"","previewIconUrl":"","eventsFunctions":[{"fullName":"","functionType":"Action","name":"onCreated","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ResetObjectTimer"},"parameters":["Object","\"__FireBullet.FiringCooldown\""]},{"type":{"value":"SetNumberVariable"},"parameters":["AmmoQuantity","=","StartingAmmo"]},{"type":{"value":"SetNumberVariable"},"parameters":["ShotsBeforeNextReload","=","ShotsPerReload"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"FireBullet::FireBullet","t